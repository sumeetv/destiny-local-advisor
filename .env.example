# Register a PRIVATE, CONFIDENTIAL app at https://www.bungie.net/en/Application
# Scopes: ReadBasicUserProfile and ReadDestinyInventoryAndVault ONLY.
# Never put real credentials in this tracked example. Use ignored .env.local.
BUNGIE_API_KEY=
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=
BUNGIE_REDIRECT_URI=https://127.0.0.1:3000/api/auth/bungie/callback

# Trusted local certificate and private key. See README.md for mkcert setup.
BUNGIE_TLS_CERT=data/tls/cert.pem
BUNGIE_TLS_KEY=data/tls/key.pem

# Optional: choose explicitly if there are multiple accounts without cross-save.
BUNGIE_MEMBERSHIP_ID=
BUNGIE_MEMBERSHIP_TYPE=
